{
  "name": "xion-launcher",
  "version": "1.18.0",
  "description": "Xion Launcher - premium Minecraft launcher (Vanilla, Fabric, Quilt, Paper servers)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": {
    "name": "Xion",
    "email": "armrtech.bd@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "skinview3d": "^3.4.2"
  },
  "productName": "Xion Launcher",
  "build": {
    "appId": "net.xion.launcher",
    "productName": "Xion Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Xion Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Xion-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "XionLauncher-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "anisbabu",
        "repo": "xion-launcher",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "xion-launcher",
      "synopsis": "Premium Minecraft launcher",
      "description": "Xion Launcher - premium Minecraft launcher (Vanilla, Fabric, Quilt, Paper servers)",
      "desktop": {
        "entry": {
          "Name": "Xion Launcher",
          "Comment": "Premium Minecraft launcher",
          "Categories": "Game;",
          "Keywords": "minecraft;launcher;xion;"
        }
      },
      "artifactName": "Xion-Launcher-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://xion-launcher.vercel.app"
}
